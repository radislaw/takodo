{
  "name": "@tootoo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@prisma/client": "^6.9.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.2.1",
    "fastify-openapi-glue": "^4.11.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.0",
    "prisma": "^6.9.0",
    "tsx": "^4.19.2",
    "typescript": "~6.0.0",
    "vitest": "^4.1.8",
    "vitest-mock-extended": "^4.0.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}

DATABASE_URL="postgresql://tootoo:tootoo@127.0.0.1:5432/tootoo"
SEED_USER_EMAIL="dev@tootoo.local"
# Dev login password for the seed user (POST /auth/login with SEED_USER_EMAIL).
SEED_USER_PASSWORD="devpassword"

# ─── Auth (JWT) ───────────────────────────────────────────────
# Long random strings — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Access-token lifetime (≤15m) and refresh-token lifetime.
ACCESS_TTL="15m"
REFRESH_TTL="30d"
# Base URL the web app handles OAuth callbacks on, e.g. http://localhost:5173
OAUTH_REDIRECT_BASE="http://localhost:5173"

# ─── OAuth providers (optional — only the ones you enable) ─────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Apple Sign in: client_secret is an ES256 JWT signed from the .p8 key.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Web Push / VAPID — generate once with: node -e "const wp=require('web-push');const k=wp.generateVAPIDKeys();console.log(k)"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ─── AI assistant (OpenAI-compatible; default Z.AI GLM-4.7-Flash, free) ─────
# Provider-agnostic: keep the OpenAI dialect, swap provider by changing these 3.
# Default Z.AI GLM-4.7-Flash: free, no card, reliable native tool-calling.
# Key (no card): https://z.ai/model-api . Absent → /ai/* replies 503.
LLM_API_KEY=
LLM_BASE_URL="https://api.z.ai/api/paas/v4"
LLM_MODEL="glm-4.7-flash"
# Alternatives (same 3 vars, OpenAI-compatible):
#   Z.AI paid fallback if free rate-limited: LLM_MODEL="glm-4.7-flashx" (~$0.07/$0.40 per MTok)
#   DeepSeek: LLM_BASE_URL="https://api.deepseek.com" LLM_MODEL="deepseek-chat"
#   Gemini:   LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai" LLM_MODEL="gemini-2.5-flash"
#   Groq:     LLM_BASE_URL="https://api.groq.com/openai/v1" LLM_MODEL="llama-3.3-70b-versatile" (weak tool-calling — emits text-format)

# Rate limit on POST /ai/conversations/{id}/messages (each turn hits the LLM and
# burns free-tier quota). Defaults shown; reads are never throttled.
AI_RATE_MAX="20"
AI_RATE_WINDOW="5 minutes"
